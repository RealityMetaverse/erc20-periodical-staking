# DeployV040 on Polygon Amoy testnet (chain 80002).
# cp deploy/v040/amoy.env.example deploy/v040/amoy.env, fill in the "<placeholders>", then
#   ./script/deploy-v040.sh amoy              # simulate
#   ./script/deploy-v040.sh amoy --broadcast  # send
# See deploy/v040/example.env for every variable and its meaning.

CHAIN_NAME=amoy
RPC_URL="<https://amoy-rpc-url>"

# Network constants (safe to commit)
# Source: the previous Amoy VIP staking contract, v0.2.4 (backend PERIODIC_STAKING_2)
SOURCE_STAKING=0x0d8ab209583050A9959322229A7c314c66e40E6f
# Worth-aggregating RequirementCheckerV2 the backend reads (backend REQUIREMENT_CHECKER_V2).
# Not the source's own requirementChecker() hook (0xE751c4D2dDa2bfc8fB501BAf1369548701e0F76B).
REQUIREMENT_CHECKER_V2=0x3D55e53835e90149BCe416881b4b677EB107d4e3

# Required
VOUCHER_SIGNER="<0x-voucher-signer-address>"
TREASURY="<0x-treasury-address>"
MAX_EXTRA_APY_BPS="<bps>"
MAX_EXTRA_LIMIT="<token-wei>"

# Deployer / signing
DEPLOYER_ADDRESS="<0x-deployer-address>"
DEPLOYER_ACCOUNT="<keystore-account-name>"
# ETHERSCAN_API_KEY=

# Optional
# NEW_OWNER="<0x-new-owner>"
# ADMINS="<0x-admin-1>,<0x-admin-2>"
# OPEN_STAKING=false
# REWARD_TOP_UP=0
# WALLET_LIMITS_FILE="deploy/v040/amoy-wallet-limits.csv"
