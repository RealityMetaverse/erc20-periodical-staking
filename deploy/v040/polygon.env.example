# DeployV040 on Polygon mainnet (chain 137).
# cp deploy/v040/polygon.env.example deploy/v040/polygon.env, fill in the "<placeholders>", then
#   ./script/deploy-v040.sh polygon              # simulate
#   ./script/deploy-v040.sh polygon --broadcast  # send
# See deploy/v040/example.env for every variable and its meaning.

CHAIN_NAME=polygon
RPC_URL="<https://polygon-rpc-url>"

# Network constants (safe to commit)
# Source: the previous VIP staking contract, v0.2.4 (backend PERIODIC_STAKING_2)
SOURCE_STAKING=0xa816fC819c2BD73c0AEdf60E0b06daF2Bff9691F
# Worth-aggregating RequirementCheckerV2 the backend reads (backend REQUIREMENT_CHECKER_V2)
REQUIREMENT_CHECKER_V2=0x716ff1f64cC2B7c96ba9DDADfc08bB703F8bcA59

# Required
VOUCHER_SIGNER="<0x-voucher-signer-address>"
TREASURY="<0x-treasury-address>"
MAX_EXTRA_APY_BPS="<bps>"
MAX_EXTRA_LIMIT="<token-wei>"

# Deployer / signing
DEPLOYER_ADDRESS="<0x-deployer-address>"
DEPLOYER_ACCOUNT="<keystore-account-name>"
# ETHERSCAN_API_KEY=

# Optional
# NEW_OWNER="<0x-new-owner>"
# ADMINS="<0x-admin-1>,<0x-admin-2>"
# OPEN_STAKING=false
# REWARD_TOP_UP=0
# WALLET_LIMITS_FILE="deploy/v040/polygon-wallet-limits.csv"
