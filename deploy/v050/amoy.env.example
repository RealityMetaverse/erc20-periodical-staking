# DeployV050 on Polygon Amoy testnet (chain 80002).
# cp deploy/v050/amoy.env.example deploy/v050/amoy.env, fill in the "<placeholders>", then
#   ./script/deploy-v050.sh amoy              # simulate
#   ./script/deploy-v050.sh amoy --broadcast  # send
# See deploy/v050/example.env for every variable and its meaning.

CHAIN_NAME=amoy
RPC_URL="<https://amoy-rpc-url>"

# Network constants (safe to commit)
# Source: the previous Amoy VIP staking contract, v0.2.4 (backend PERIODIC_STAKING_2)
SOURCE_STAKING=0x0d8ab209583050A9959322229A7c314c66e40E6f
# Worth-aggregating RequirementCheckerV2 the backend reads (backend REQUIREMENT_CHECKER_V2).
# Not the source's own requirementChecker() hook (0xE751c4D2dDa2bfc8fB501BAf1369548701e0F76B).
REQUIREMENT_CHECKER_V2=0x3D55e53835e90149BCe416881b4b677EB107d4e3

# Required
VOUCHER_SIGNER="<0x-voucher-signer-address>"
TREASURY="<0x-treasury-address>"
# ALL THREE ceilings (MAX_EXTRA_APY_BPS, MAX_EXTRA_LIMIT_TOTAL, MAX_EXTRA_LIMIT_PER_CELL) must be AT OR ABOVE the
# largest value in the backend's VIP staking perk grid (backend admin: VIP perk config page). The backend refuses
# to sign a voucher whose extras exceed a ceiling, and staking is voucher-only, so every VIP level above a ceiling
# could not stake AT ALL. Raise the ceiling or lower the grid first; setMaxExtra*() can change a ceiling later.
MAX_EXTRA_APY_BPS="<bps>"
MAX_EXTRA_LIMIT_TOTAL="<token-wei>"
MAX_EXTRA_LIMIT_PER_CELL="<token-wei>"
# Furthest ahead of now a voucher's validUntil may sit, in seconds. Must be non-zero. MUST be >= the
# backend's configured validity_seconds (backend bounds it 60-1800) or every voucher reverts. Ops sets it.
MAX_VOUCHER_VALIDITY="<seconds>"
# Optional but strongly recommended: the backend's staking voucher validity_seconds - the on-chain ceiling
# MAX_VOUCHER_VALIDITY must be >= this. Set it and both wrappers refuse a ceiling below it instead of warning.
# BACKEND_VALIDITY_SECONDS="<seconds>"

# Deployer / signing
DEPLOYER_ADDRESS="<0x-deployer-address>"
DEPLOYER_ACCOUNT="<keystore-account-name>"
# ETHERSCAN_API_KEY=

# Optional
# Both contracts are two-step: this only nominates. NEW_OWNER must acceptOwnership() on the staking contract
# AND on the LimitController before the hand-off is done. --verify-only FAILS on a half-finished hand-off
# (one accepted, one forgotten), so it is the check that both calls landed.
# NEW_OWNER="<0x-new-owner>"
# ADMINS="<0x-admin-1>,<0x-admin-2>"
# OPEN_STAKING=false
# REWARD_TOP_UP=0
# WALLET_LIMITS_FILE="deploy/v050/amoy-wallet-limits.csv"
# Default false: one address per role, a clash FAILS the preflight. true downgrades each clash to a warning -
# which is what a testnet like Amoy usually wants, where one key is signer, deployer and treasury at once.
# ALLOW_SHARED_ROLES=false

# Verify-only (script/deploy-v050.sh amoy --verify-only): re-runs the configuration self-check against the
# contracts ON CHAIN and sends nothing. Mandatory after a broadcast - the self-check inside the broadcast run
# reads the simulation, not what was mined. Needs these two plus DEPLOYER_ADDRESS above.
# VERIFY_STAKING="<0x-deployed-staking>"
# VERIFY_CONTROLLER="<0x-deployed-limit-controller>"
# VERIFY_ONLY is set by the --verify-only argument, never here.
# VERIFY_ONLY=
