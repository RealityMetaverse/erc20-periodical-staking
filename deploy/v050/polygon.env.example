# DeployV050 on Polygon mainnet (chain 137).
# cp deploy/v050/polygon.env.example deploy/v050/polygon.env, fill in the "<placeholders>", then
#   ./script/deploy-v050.sh polygon              # simulate
#   ./script/deploy-v050.sh polygon --broadcast  # send
# See deploy/v050/example.env for every variable and its meaning.

CHAIN_NAME=polygon
RPC_URL="<https://polygon-rpc-url>"

# Network constants (safe to commit)
# Source: the previous VIP staking contract, v0.2.4 (backend PERIODIC_STAKING_2)
SOURCE_STAKING=0xa816fC819c2BD73c0AEdf60E0b06daF2Bff9691F
# Worth-aggregating RequirementCheckerV2 the backend reads (backend REQUIREMENT_CHECKER_V2)
REQUIREMENT_CHECKER_V2=0x716ff1f64cC2B7c96ba9DDADfc08bB703F8bcA59

# Required
VOUCHER_SIGNER="<0x-voucher-signer-address>"
TREASURY="<0x-treasury-address>"
# ALL THREE ceilings (MAX_EXTRA_APY_BPS, MAX_EXTRA_LIMIT_TOTAL, MAX_EXTRA_LIMIT_PER_CELL) must be AT OR ABOVE the
# largest value in the backend's VIP staking perk grid (backend admin: VIP perk config page). The backend refuses
# to sign a voucher whose extras exceed a ceiling, and staking is voucher-only, so every VIP level above a ceiling
# could not stake AT ALL. Raise the ceiling or lower the grid first; setMaxExtra*() can change a ceiling later.
MAX_EXTRA_APY_BPS="<bps>"
MAX_EXTRA_LIMIT_TOTAL="<token-wei>"
MAX_EXTRA_LIMIT_PER_CELL="<token-wei>"
# Furthest ahead of now a voucher's validUntil may sit, in seconds. Must be non-zero. MUST be >= the
# backend's configured validity_seconds (backend bounds it 60-1800) or every voucher reverts. Ops sets it.
MAX_VOUCHER_VALIDITY="<seconds>"
# Optional but strongly recommended: the backend's staking voucher validity_seconds - the on-chain ceiling
# MAX_VOUCHER_VALIDITY must be >= this. Set it and both wrappers refuse a ceiling below it instead of warning.
# BACKEND_VALIDITY_SECONDS="<seconds>"

# Deployer / signing
DEPLOYER_ADDRESS="<0x-deployer-address>"
DEPLOYER_ACCOUNT="<keystore-account-name>"
# ETHERSCAN_API_KEY=

# Optional
# NEW_OWNER="<0x-new-owner>"
# ADMINS="<0x-admin-1>,<0x-admin-2>"
# OPEN_STAKING=false
# REWARD_TOP_UP=0
# WALLET_LIMITS_FILE="deploy/v050/polygon-wallet-limits.csv"
